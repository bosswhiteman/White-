# Copiez ce fichier en .env (local) ou renseignez ces variables dans Netlify.

# Base PostgreSQL (Neon / Netlify DB recommandé). Exemple :
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Signature des sessions admin (mettez une longue chaîne aléatoire)
ADMIN_SECRET=

# Identifiants administrateur (si vides, les identifiants intégrés sont utilisés)
ADMIN_EMAIL=keitabenzoumana@gmail.com
ADMIN_PASSWORD=

# Cookies sécurisés en HTTPS (true sur Netlify)
COOKIE_SECURE=true
